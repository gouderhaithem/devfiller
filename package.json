{
  "name": "form-filler",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc -b && vite build",
    "icons": "node scripts/build-icons.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "store-assets": "node scripts/store-assets.mjs",
    "store-listing": "node scripts/store-listing-page.mjs",
    "package": "npm run build && rm -rf release && mkdir -p release && cd dist && zip -qr ../release/devfiller-$npm_package_version.zip . -x demo.html 'assets/demo-*'",
    "benchmark": "playwright test -c benchmark/playwright.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
